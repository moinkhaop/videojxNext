{
  "manifest_version": 3,
  "name": "VideoJX Next 助手",
  "version": "0.1.12",
  "description": "在抖音页面快速解析、上传、批量处理并同步历史记录。",
  "permissions": [
    "storage",
    "clipboardRead",
    "clipboardWrite",
    "activeTab",
    "tabs",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://localhost:3000/*",
    "https://dyjx.ehhx.qzz.io/*",
    "https://www.douyin.com/*",
    "https://douyin.com/*",
    "https://www.iesdouyin.com/*",
    "https://iesdouyin.com/*",
    "https://v.douyin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "VideoJX 助手",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.douyin.com/*",
        "https://douyin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
