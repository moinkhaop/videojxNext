# ===== Client-side tuning (NEXT_PUBLIC_*) =====
# 批量转存并发数（默认: 3，范围: 1-6）
NEXT_PUBLIC_BATCH_CONCURRENCY=3

# 批量任务之间的启动间隔毫秒（默认: 0）
NEXT_PUBLIC_BATCH_TASK_DELAY_MS=0

# 解析结果缓存 TTL 毫秒（默认: 300000 = 5 分钟，最小 30000）
NEXT_PUBLIC_PARSE_CACHE_TTL_MS=300000

# 解析缓存最大条目数（默认: 300，范围: 50-3000）
NEXT_PUBLIC_PARSE_CACHE_MAX_ENTRIES=300

# EdgeOne 抖音解析函数地址（可选）
# 例如: https://<your-pages-domain>/api/douyin/parse
NEXT_PUBLIC_EDGEONE_PARSER_API_URL=

# ===== Server-side tuning (Parser upstreams) =====
# 内置抖音解析器（/api/douyin/parse）将按顺序轮询上游解析源，直到成功。
# 允许格式：
# - 逗号/换行分隔：name|GET https://example.com/api?url={url}
# - JSON 数组：["name|GET https://...","POST https://..."]
DOUYIN_PARSER_TIMEOUT_MS=10000
# DOUYIN_PARSER_UPSTREAMS=jxcxin|GET https://apis.jxcxin.cn/api/douyin?url={url},douyin_wtf|GET https://api.douyin.wtf/api/hybrid/video_data?url={url}

# 内置B站解析器（/api/bilibili/parse）同样支持轮询上游；并在上游失败时尝试 B 站官方接口作为降级。
BILIBILI_PARSER_TIMEOUT_MS=10000
# BILIBILI_PARSER_UPSTREAMS=mir6|GET https://api.mir6.com/api/bzjiexi?url={url}&type=json,injahow|GET https://api.injahow.cn/bparse/?bv={bvid}
# B站画质参数 qn（默认 80）。未登录情况下可能会被限制。
BILIBILI_PARSER_QN=80

# ===== Server-side tuning (WebDAV proxy) =====
# 图集上传并发数（默认: 4，范围: 1-8）
WEBDAV_IMAGE_UPLOAD_CONCURRENCY=4

# 视频下载超时毫秒（默认: 20000，范围: 5000-120000）
WEBDAV_VIDEO_DOWNLOAD_TIMEOUT_MS=20000

# 视频下载最大重试次数（默认: 3，范围: 1-8）
WEBDAV_VIDEO_MAX_RETRIES=3
