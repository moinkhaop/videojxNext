# ===== Client-side tuning (NEXT_PUBLIC_*) =====
# 批量转存并发数（默认: 3，范围: 1-6）
NEXT_PUBLIC_BATCH_CONCURRENCY=3

# 批量任务之间的启动间隔毫秒（默认: 0）
NEXT_PUBLIC_BATCH_TASK_DELAY_MS=0

# 解析结果缓存 TTL 毫秒（默认: 300000 = 5 分钟，最小 30000）
NEXT_PUBLIC_PARSE_CACHE_TTL_MS=300000

# 解析缓存最大条目数（默认: 300，范围: 50-3000）
NEXT_PUBLIC_PARSE_CACHE_MAX_ENTRIES=300

# ===== Server-side tuning (WebDAV proxy) =====
# 图集上传并发数（默认: 4，范围: 1-8）
WEBDAV_IMAGE_UPLOAD_CONCURRENCY=4

# 视频下载超时毫秒（默认: 20000，范围: 5000-120000）
WEBDAV_VIDEO_DOWNLOAD_TIMEOUT_MS=20000

# 视频下载最大重试次数（默认: 3，范围: 1-8）
WEBDAV_VIDEO_MAX_RETRIES=3
